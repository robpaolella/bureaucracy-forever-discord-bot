# Copy to .env and fill in. Never commit .env.
# Bot token: Developer Portal -> your app -> Bot -> Reset Token
DISCORD_TOKEN=paste-your-token-here

# Your server ID. Right-click the server icon -> Copy Server ID
# (needs Advanced -> Developer Mode enabled in Discord settings).
# Optional, but makes slash commands appear instantly instead of ~1 hour.
GUILD_ID=123456789012345678

# Channel where new-member triage messages are posted.
# Right-click the channel -> Copy Channel ID. Leave blank to disable.
NEW_USER_CHANNEL_ID=1549162234888855573

# Channel where /lfg posts are allowed. Leave blank to allow anywhere.
LFG_CHANNEL_ID=

# Where the LFG database lives inside the container. Leave as-is.
LFG_DB_PATH=/data/lfg.db

# Public channel where the recruitment Apply buttons live.
RECRUIT_CHANNEL_ID=1549260321930346617

# Officer-only channel where applications are posted for review.
OFFICER_REVIEW_CHANNEL_ID=1549260110306484255

# Where the recruitment applications database lives inside the container.
RECRUIT_DB_PATH=/data/recruit.db
